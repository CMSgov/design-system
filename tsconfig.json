{
  "compilerOptions": {
    "rootDir": ".",
    "target": "es2020",
    "jsx": "react-jsx",
    "module": "nodenext",
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "typeRoots": ["./@types", "./node_modules/@types"],
    "strict": true
  },
  "include": ["packages/**/src/**/*", ".storybook/**/*"]
}
