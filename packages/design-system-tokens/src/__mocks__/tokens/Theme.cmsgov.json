{
  "theme": {
    "color": {
      "primary-light": {
        "$value": "{color.ocean.50}"
      },
      "primary": {
        "$value": "{color.ocean.100}"
      }
    }
  },
  "component": {
    "alert": {
      "background-color": {
        "$value": "{theme.color.primary-light}"
      },
      "border-color": {
        "$value": "{theme.color.primary}"
      }
    },
    "button": {
      "border-radius": {
        "$value": "{radius.small}"
      }
    }
  }
}
